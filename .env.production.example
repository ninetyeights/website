COMPOSE_PROJECT_NAME=ninetyeights
LOCAL_UID=1000
LOCAL_GID=1000
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_DB=ninetyeights
POSTGRES_USER=ninetyeights
POSTGRES_PASSWORD=

# Localhost only. Explicitly opt in to LAN access after configuring HTTPS.
TRUSTED_PROXY_IPS=
DEV_ALLOWED_ORIGINS=127.0.0.1

# Analytics is disabled until both settings are filled. Runtime settings; no rebuild needed.
GA_MEASUREMENT_ID=
GA_ALLOWED_DOMAINS=ninetyeights.com,www.ninetyeights.com

# Public primary origin for canonical, sitemap.xml and robots.txt; rebuild frontend after changes.
SITE_URL=https://ninetyeights.com

# Exact source IP of the VPS host proxy as seen by Docker (set on the VPS).
HOST_PROXY_IP=127.0.0.1
